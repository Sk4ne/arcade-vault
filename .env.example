# Resend — solo servidor (no usar prefijo NEXT_PUBLIC_)
RESEND_API_KEY=re_xxx

# Destinatario del formulario de contacto.
# En desarrollo con onboarding@resend.dev, Resend solo entrega al correo dueño de la cuenta.
CONTACT_TO_EMAIL=equipo@ejemplo.com

# Remitente. En producción, usar un dominio verificado en Resend.
CONTACT_FROM_EMAIL=Arcade Vault <onboarding@resend.dev>

# Supabase — URL del proyecto (Project Settings → API). Pública por diseño.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# Supabase — publishable key (sb_publishable_…). Pensada para el navegador; no usar la anon key legacy.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Contraseña de la base de datos. Solo la usa la CLI (supabase link / db push). Nunca con prefijo NEXT_PUBLIC_.
SUPABASE_DB_PASSWORD=xxxx
